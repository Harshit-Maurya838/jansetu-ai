# Copy to .env and fill in. Never commit .env.

# --- Database (docker compose + backend) ---
DB_USERNAME=jansetu
DB_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# --- Auth ---
# Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_TTL=PT15M
JWT_REFRESH_TTL=P30D

# First SUPER_ADMIN, seeded on startup only if no SUPER_ADMIN exists. Outside the dev profile startup fails
# if SUPERADMIN_MOBILE / SUPERADMIN_PASSWORD are missing or the password is weak (min 8 chars, letters + digits).
SUPERADMIN_NAME=Super Admin
SUPERADMIN_MOBILE=
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# --- Email OTP (forgot-password by email). Not used in the dev profile (OTPs are printed to the console). ---
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# --- AI service (shared secret between backend and ai-service; not exposed to the app) ---
# Generate with: openssl rand -hex 32
AI_SERVICE_API_KEY=

# --- Notifications ---
# Path to the Firebase service-account JSON (keep outside the repo)
FIREBASE_CREDENTIALS_PATH=
# TODO(team): choose an SMS gateway for OTP + SOS fallback (must be DLT-registered in India)
SMS_GATEWAY_PROVIDER=
SMS_GATEWAY_API_KEY=
SMS_SENDER_ID=

# --- Mobile app (read by mobile/.env via react-native-config or similar) ---
# Android emulator reaches the host machine at 10.0.2.2
API_BASE_URL=http://10.0.2.2:8080/api/v1

# --- Cloud (TODO(team): pick Google Cloud or AWS) ---
CORS_ALLOWED_ORIGINS=
