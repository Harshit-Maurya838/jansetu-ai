# Copy to .env and pick one. Restart `npm start` after changing it.
# USB (after `adb reverse tcp:8080 tcp:8080`):
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
# Wi-Fi (phone and laptop on the same network; use the laptop's LAN IP):
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.50:8080/api/v1
